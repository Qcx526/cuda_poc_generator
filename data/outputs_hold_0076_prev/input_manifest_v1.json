  "dimensions": {
    "os_environment": {
      "cve_id": "CVE-2024-0076",
      "os_name": "Windows / Linux (cross-platform)",
      "os_version": "Any OS with NVIDIA CUDA Toolkit installed",
      "kernel_version": "N/A — cuobjdump is a pure userspace ELF parser. No kernel interaction.",
      "architecture": "x86_64",
      "notes": "Cross-platform. Both cuobjdump.exe and nvdisasm.exe on Windows are affected. No GPU or driver needed — pure file parsing vulnerability."
    },
    "cuda_environment": {
      "cve_id": "CVE-2024-0076",
      "cuda_driver_version": "Not required — cuobjdump is a CPU-only tool. No GPU driver needed.",
      "cuda_toolkit_version": "All versions prior to CUDA Toolkit 12.4. CUDA 11.2 is fully affected.",
      "gpu_architecture": "Not required. PoC runs on any machine with CUDA Toolkit installed — no GPU needed.",
      "compute_capability": "N/A",
      "gpu_model": "N/A",
      "affected_tools": [
        "cuobjdump + nvdisasm"
      ]
    },
    "affected_component": {
      "cve_id": "CVE-2024-0076",
      "name": "cuobjdump + nvdisasm",
      "component_name": "NVIDIA CUDA cuobjdump + nvdisasm (CUDA Binary Utilities)",
      "version_range": "All versions prior to CUDA Toolkit 12.4. CUDA 11.2 is fully affected.",
      "vendor": "NVIDIA Corporation",
      "advisory_url": "https://nvidia.custhelp.com/app/answers/detail/a_id/5517"
    },
    "attack_surface": {
      "cve_id": "CVE-2024-0076",
      "surface_type": "File-format parser — malicious ELF/cubin input",
      "entry_point": "User executes cuobjdump + nvdisasm on a maliciously crafted cubin file. The tool parses the ELF headers and section data, reaching the vulnerable code path.",
      "attack_vector": "Attacker provides a specially crafted .cubin (ELF64) file. When the victim runs 'cuobjdump + nvdisasm malicious.cubin', the parser processes the corrupted fields and triggers the vulnerability.",
      "privilege_required": "None — any user who can execute the CUDA tool and provide a file path can trigger the bug.",
      "trigger_mechanism": "Provide a malformed cubin file with corrupted section header fields (e.g., sh_size, sh_offset) that cause the parser to compute an out-of-bounds read offset. The tool reads from heap memory outside the allocated buffer."
    },
    "vulnerability_type": {
      "cve_id": "CVE-2024-0076",
      "cwe_id": "CWE-125",
      "cwe_name": "Out-of-bounds Read",
      "vulnerability_category": "125",
      "cvss_score": "3.3",
      "cvss_severity": "LOW",
      "cvss_vector": "CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:L/I:N/A:L",
      "subtype": "Out-of-bounds Read in CUDA binary utilities",
      "related_cwe": [],
      "validation_impact": "Information disclosure via heap memory read OOB. Can also cause denial of service if the OOB read hits unmapped memory. CVSS 3.3 LOW, but useful for demonstrating CWE-125 exploitation primitive."
    },
    "impact_controllability": {
      "cve_id": "CVE-2024-0076",
      "impact": "Information disclosure via heap memory read OOB. Can also cause denial of service if the OOB read hits unmapped memory. CVSS 3.3 LOW, but useful for demonstrating CWE-125 exploitation primitive.",
      "controllable_fields": [
        "ELF/cubin file content — attacker controls all bytes",
        "Section headers (sh_size, sh_offset, sh_link, sh_info)",
        "Section data content",
        "Number and arrangement of ELF sections"
      ],
      "exploitation_difficulty": "Low-Medium. The bug is deterministic — same crafted file always triggers. No race condition or heap grooming required for basic crash PoC."
    },
    "root_cause": {
      "cve_id": "CVE-2024-0076",
      "summary": "Both cuobjdump and nvdisasm contain an out-of-bounds read vulnerability when processing malformed ELF/cubin files. A crafted file can cause the tool to read memory beyond the bounds of an allocated buffer, potentially leaking heap data or causing a crash via invalid memory access.",
      "cwe_classification": "CWE-125: Out-of-bounds Read",
      "cuda_subsystem": "CUDA Toolchain — cuobjdump + nvdisasm ELF/cubin parser",
      "technical_details": [
        "Both cuobjdump and nvdisasm contain an out-of-bounds read vulnerability when processing malformed ELF/cubin files. A crafted file can cause the tool to read memory beyond the bounds of an allocated buffer, potentially leaking heap data or causing a crash via invalid memory access."
      ],
      "patch_analysis": "Fixed in CUDA Toolkit affected. See https://nvidia.custhelp.com/app/answers/detail/a_id/5517.",
      "exploit_requirements": [
        "Ability to create a valid ELF/cubin file (nvcc can produce base file)",
        "Craft the file to trigger CWE-125 in cuobjdump + nvdisasm",
        "Run cuobjdump + nvdisasm on the crafted file"
      ]
    }
  },
