# Python caches, tests and packaging
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/
.eggs/

# Windows/Linux virtual environments; preserve existing Conda environments
.venv/
.venv-*/
venv/
env/
.conda/
conda-env/
environment.local.yml
environment.local.yaml
conda-export*.yml
conda-export*.yaml
conda-explicit*.txt

# Credentials and local configuration (templates remain trackable)
.env
.env.*
!.env.example
*.env.local
config/local.yaml
config/local.yml
config/*.local.yaml
config/*.local.yml
credentials/
secrets/
*.pem
*.key

# IDE/user session data; keep portable shared project settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace
.workbuddy/
.reasonix/
.docs/

# Runtime outputs only: do not ignore data/, source CUDA files or fixtures
data/outputs/*
!data/outputs/.gitkeep
# Private reproduction references: real PoCs, cubins and crash logs. They are
# inputs to comparison runs and must never be published.
data/reference/
data/knowledge_bases/.chromadb/
.chromadb/
logs/
runs/
data/outputs/*/artifacts/
!demo/*/artifacts/
!demo/*/artifacts/*.cubin
tmp/
.tmp/
benchmark/results/
benchmarks/results/
data/benchmark_results/
data/probes/
data/llm_logs/

# CUDA artifacts belong in the explicit runtime/build locations above.
# Do not broadly ignore research *.cu/*.cubin/*.log files.
a.out
a.exe

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# 一次性 fuzz/探针产物（体积大、可重新生成）
data/fuzz*/
data/probeA/
data/probeB/

# Novel crashes: keep the index, never the binaries
data/findings/novel/**/*.cubin
data/findings/novel/**/*.elf
data/findings/novel/**/*.fatbin
# demo outputs (regenerated by `make demo`)
demo/*/out/
demo/*/artifacts/_matrix.sh
demo/*/artifacts/crashcap.c

# 研究过程数据：完整内容在 research/full 分支，main 只保留 demo 所需
data/loop/*
data/outputs/*
data/outputs_hold_*/
data/tmp_evs/*
data/control/*
data/mutation/*
data/probe/
data/nvapi_sdk/
data/knowledge_bases_pending/

# 发现目录：保留展示用样本（每条几 KB），但不重复提交 crashcap 副本
data/findings/**/crashcap.c
!data/findings/novel/CVE-2024-0076/**/*.cubin

# 目录占位文件仍可提交
!data/outputs/.gitkeep
!data/loop/.gitkeep
!data/control/.gitkeep
!data/mutation/.gitkeep
!data/tmp_evs/.gitkeep

# 根目录的运行日志
/out/
demo/*/artifacts/*.so
demo/*/artifacts/observation.txt

# 根目录的运行产物（demo 下的样本不受影响）
/artifacts/

# 厂商二进制：体积大且不可分发，只记录路径与结论
data/driver/binary/*.sys
data/driver/binary/*.dll
data/driver/binary/*.exe
