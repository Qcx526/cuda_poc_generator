# CUDA PoC Generator — 环境变量配置模板
# 复制为 .env 并填入真实 API Key
# .env 文件已加入 .gitignore，不会被提交到 Git

# NIUBIAPI 中转站（OpenAI 兼容接口）
# URL 与额外请求头已在 config/default.yaml 中配置:
#   base_url = https://www.niubiapi.com/v1
#   headers  = User-Agent: claude-cli/2.0.76 (external, cli)
NIUBIAPI_KEY=sk-your-niubiapi-key-here

# Tavily Search API（Web 搜索，可选）
TAVILY_API_KEY=tvly-your-tavily-key-here

# 可选: 覆盖 config/default.yaml 中的模型名（中转站没有默认模型时在此指定）
# CPG_LLM_MODEL_NAME=gpt-5.6-sol
