# Copy to .env locally. Never commit real credentials.
# Official DeepSeek API; the existing DEEPSEEK_KEY name remains supported.
DEEPSEEK_API_KEY=
# DEEPSEEK_KEY=
CPG_LLM_MODEL_NAME=deepseek-flash
CPG_LLM_API_BASE=https://api.deepseek.com
CPG_LLM_API_KEY_ENV=DEEPSEEK_API_KEY

# RAG defaults to true in YAML. First use may download a CPU embedding model.
# CPG_RAG_ENABLED=false

# Optional Tavily search: install .[search]; an unset key skips web search.
TAVILY_API_KEY=

# External tracing can contain prompts/private inputs; disabled by default.
LANGCHAIN_TRACING_V2=false
